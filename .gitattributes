# Keep LF in the repository and working tree on every platform.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.otf binary
*.jar binary

# Third-party license texts are kept byte-for-byte as published, trailing spaces included.
app/src/main/assets/licenses/*.txt whitespace=-trailing-space

# Mermaid ships as its published minified bundle (see app/src/main/assets/mermaid/README.md).
app/src/main/assets/mermaid/mermaid.min.js -text -diff linguist-vendored
